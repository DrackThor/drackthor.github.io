---
import KbLayout from "../../layouts/KbLayout.astro";
import { getCollection, render } from "astro:content";
import { buildKbTree, type TreeNode } from "../../lib/kbTree";
import type { MarkdownHeading } from "astro";

// Drafts are excluded from production builds, included in dev for review.
// NOTE: getStaticPaths runs isolated and can't see module-scope consts, so the
// predicate is inlined here and below rather than shared via a variable.
export async function getStaticPaths() {
  const entries = await getCollection(
    "kb",
    ({ data }) => import.meta.env.DEV || !data.draft,
  );

  const articles = entries
    .map((entry) => ({ slug: entry.id.replace(/\/?index$/, ""), entry }))
    .filter(({ slug }) => slug.length > 0)
    .map(({ slug, entry }) => ({ params: { slug }, props: { entry } }));

  // The /kb listing is only emitted when there is something to list — so with
  // no published articles the route (and its sitemap entry) does not exist.
  const listing =
    entries.length > 0
      ? [{ params: { slug: undefined }, props: { entry: null } }]
      : [];

  return [...listing, ...articles];
}

const { entry } = Astro.props;

let Content: Awaited<ReturnType<typeof render>>["Content"] | null = null;
let headings: MarkdownHeading[] = [];
let sections: TreeNode[] = [];

if (entry) {
  ({ Content, headings } = await render(entry));
} else {
  // The landing page only lists published articles. Drafts stay reachable by
  // direct URL in dev (see getStaticPaths) but are not advertised here.
  const entries = await getCollection("kb", ({ data }) => !data.draft);
  sections = buildKbTree(
    entries.map((e) => ({ id: e.id, title: e.data.title })),
  );
}
---

{entry && Content ? (
  <KbLayout {...entry.data} headings={headings}>
    <Content />
  </KbLayout>
) : (
  <KbLayout title="Knowledge Base 📚">
    <p class="lead">
      Beginner-friendly notes on cloud-native tech, DevOps and modern software
      development.
    </p>

    {sections.map((section) => (
      <section class="not-prose kb-section">
        <h2 class="kb-section-title">
          {section.href ? (
            <a href={section.href}>{section.title ?? section.name}</a>
          ) : (
            (section.title ?? section.name)
          )}
        </h2>
        {section.children.length > 0 && (
          <ul class="kb-section-list">
            {section.children.map((child) => (
              <li>
                <a href={child.href}>{child.title ?? child.name}</a>
              </li>
            ))}
          </ul>
        )}
      </section>
    ))}
  </KbLayout>
)}

<style>
  .kb-section {
    margin-top: 2rem;
  }

  .kb-section-title {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .kb-section-title a {
    color: inherit;
    text-decoration: none;
  }

  .kb-section-title a:hover {
    text-decoration: underline;
  }

  .kb-section-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid
      color-mix(in oklab, var(--color-base-content) 15%, transparent);
  }

  .kb-section-list li a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    color: inherit;
    text-decoration: none;
    opacity: 0.8;
  }

  .kb-section-list li a:hover {
    opacity: 1;
    text-decoration: underline;
  }
</style>

---
// Click-to-zoom for article images and rendered Mermaid diagrams.
//
// Uses a native <dialog>, so Esc-to-close, focus trapping and the backdrop are
// free. Clicks are delegated from the document, which means diagrams Mermaid
// injects after page load are picked up without re-binding anything.
---

<dialog id="kbzoom" class="kbzoom" aria-label="Image viewer">
  <div class="kbzoom-stage" id="kbzoom-stage">
    <div class="kbzoom-canvas" id="kbzoom-canvas"></div>
  </div>
  <div class="kbzoom-bar">
    <button
      type="button"
      class="kbzoom-btn"
      data-zoom="out"
      aria-label="Zoom out"
    >
      −
    </button>
    <span class="kbzoom-level" id="kbzoom-level">
      100%
    </span>
    <button
      type="button"
      class="kbzoom-btn"
      data-zoom="in"
      aria-label="Zoom in"
    >
      +
    </button>
    <button type="button" class="kbzoom-btn" data-zoom="reset">
      Reset
    </button>
    <button
      type="button"
      class="kbzoom-btn"
      data-zoom="close"
      aria-label="Close"
    >
      ✕
    </button>
  </div>
</dialog>

<script>
  const MIN = 0.2;
  const MAX = 8;
  const SELECTOR = ".prose img, .mermaid-rendered svg";

  let scale = 1;
  let tx = 0;
  let ty = 0;
  // Scale at which the diagram fits the viewport; what "Reset" returns to.
  let baseScale = 1;

  const els = () => ({
    dialog: document.getElementById("kbzoom") as HTMLDialogElement | null,
    canvas: document.getElementById("kbzoom-canvas"),
    stage: document.getElementById("kbzoom-stage"),
    level: document.getElementById("kbzoom-level"),
  });

  // Lower bound follows baseScale, so artwork too large to fit at MIN can
  // still be zoomed out far enough to see all of it.
  const clamp = (n: number) =>
    Math.min(MAX, Math.max(Math.min(MIN, baseScale), n));

  function apply() {
    const { canvas, level } = els();
    if (!canvas) return;
    canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
    if (level) level.textContent = `${Math.round(scale * 100)}%`;
  }

  function reset() {
    scale = baseScale;
    tx = 0;
    ty = 0;
    apply();
  }

  /**
   * Intrinsic size of the thing being opened. Mermaid's SVG carries
   * width="100%", which collapses to nothing once it is out of the article
   * flow, so the rendered box (or the viewBox) is what we size the clone by.
   */
  function naturalSize(el: Element): { w: number; h: number } {
    if (el instanceof HTMLImageElement && el.naturalWidth > 0) {
      return { w: el.naturalWidth, h: el.naturalHeight };
    }
    const box = el.getBoundingClientRect();
    if (box.width > 0 && box.height > 0) {
      return { w: box.width, h: box.height };
    }
    const viewBox = el
      .getAttribute("viewBox")
      ?.split(/[\s,]+/)
      .map(Number);
    if (viewBox?.length === 4 && viewBox[2] > 0 && viewBox[3] > 0) {
      return { w: viewBox[2], h: viewBox[3] };
    }
    return { w: 800, h: 600 };
  }

  /** Zooms around a point, so whatever is under the cursor stays put. */
  function zoomAt(factor: number, px = 0, py = 0) {
    const next = clamp(scale * factor);
    const ratio = next / scale;
    tx = px - (px - tx) * ratio;
    ty = py - (py - ty) * ratio;
    scale = next;
    apply();
  }

  function open(source: Element) {
    const { dialog, canvas } = els();
    if (!dialog || !canvas) return;

    const { w, h } = naturalSize(source);
    const clone = source.cloneNode(true) as HTMLElement;

    // Pin a concrete size: percentage/auto sizing has nothing to resolve
    // against inside the viewer, and Mermaid's max-width would cap the zoom.
    clone.removeAttribute("width");
    clone.removeAttribute("height");
    clone.style.width = `${w}px`;
    clone.style.height = `${h}px`;
    clone.style.maxWidth = "none";
    clone.style.maxHeight = "none";
    canvas.replaceChildren(clone);

    // Open fitted to the viewport - a wide diagram is unreadable at the size
    // it has in the article column, which is the whole point of opening it.
    // Leaves headroom for the toolbar along the bottom.
    const fit = Math.min(
      (window.innerWidth * 0.92) / w,
      (window.innerHeight * 0.82) / h,
    );
    // SVG scales losslessly, so fill the viewport. A raster image stops at its
    // natural size - blowing a small photo up 8x only makes it blurry.
    const vector = !(source instanceof HTMLImageElement);
    baseScale = Math.min(fit, vector ? MAX : 1);
    reset();
    dialog.showModal();
  }

  // Delegated: works for images present at load and diagrams added later.
  document.addEventListener("click", (e) => {
    const target = e.target as Element | null;
    const hit = target?.closest?.(SELECTOR);
    // Leave linked images alone - the link is the more likely intent.
    if (!hit || hit.closest("a") || hit.closest(".kbzoom")) return;
    e.preventDefault();
    open(hit);
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    const { dialog } = els();
    if (!dialog?.open) return;

    const action = target?.closest<HTMLElement>("[data-zoom]")?.dataset.zoom;
    if (action === "in") zoomAt(1.3);
    else if (action === "out") zoomAt(1 / 1.3);
    else if (action === "reset") reset();
    else if (action === "close") dialog.close();
    // A click landing on the dialog itself is a click on the backdrop.
    else if (target === dialog) dialog.close();
  });

  document.addEventListener(
    "wheel",
    (e) => {
      const { dialog, stage } = els();
      if (!dialog?.open || !stage) return;
      e.preventDefault();
      const box = stage.getBoundingClientRect();
      zoomAt(
        e.deltaY < 0 ? 1.12 : 1 / 1.12,
        e.clientX - box.left - box.width / 2,
        e.clientY - box.top - box.height / 2,
      );
    },
    { passive: false },
  );

  // Drag to pan.
  let dragging = false;
  let lastX = 0;
  let lastY = 0;

  document.addEventListener("pointerdown", (e) => {
    const { dialog, stage } = els();
    if (!dialog?.open || !stage?.contains(e.target as Node)) return;
    if ((e.target as Element).closest("[data-zoom]")) return;
    dragging = true;
    lastX = e.clientX;
    lastY = e.clientY;
    stage.setPointerCapture(e.pointerId);
  });

  document.addEventListener("pointermove", (e) => {
    if (!dragging) return;
    tx += e.clientX - lastX;
    ty += e.clientY - lastY;
    lastX = e.clientX;
    lastY = e.clientY;
    apply();
  });

  document.addEventListener("pointerup", () => {
    dragging = false;
  });

  document.addEventListener("dblclick", (e) => {
    const { dialog, stage } = els();
    if (dialog?.open && stage?.contains(e.target as Node)) reset();
  });

  // Free the clone so a large diagram is not retained after closing.
  // `close` does not bubble, so this listens in the capture phase.
  document.addEventListener(
    "close",
    (e) => {
      if ((e.target as HTMLElement)?.id === "kbzoom") {
        document.getElementById("kbzoom-canvas")?.replaceChildren();
      }
    },
    true,
  );
</script>

<style is:global>
  /* Signals the images are interactive. Global: these live in rendered
     markdown and in Mermaid output, neither of which carries a scope id. */
  .prose img,
  .mermaid-rendered svg {
    cursor: zoom-in;
  }
</style>

<style>
  .kbzoom {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
  }

  .kbzoom::backdrop {
    background: rgb(0 0 0 / 0.85);
  }

  .kbzoom-stage {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    overflow: hidden;
    cursor: grab;
    touch-action: none;
  }

  .kbzoom-stage:active {
    cursor: grabbing;
  }

  .kbzoom-canvas {
    transform-origin: center center;
    will-change: transform;
    line-height: 0;
  }

  /* The clone is sized in px by the script, so no constraints here - they
     would fight the fit-to-viewport scale. */
  .kbzoom-canvas :global(img),
  .kbzoom-canvas :global(svg) {
    display: block;
  }

  .kbzoom-bar {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    translate: -50% 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem;
    border-radius: 0.6rem;
    background: var(--color-base-200, #1f2430);
    box-shadow: 0 4px 20px rgb(0 0 0 / 0.4);
  }

  .kbzoom-btn {
    min-width: 2rem;
    padding: 0.3rem 0.6rem;
    border: none;
    border-radius: 0.4rem;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .kbzoom-btn:hover {
    background: color-mix(in oklab, currentColor 15%, transparent);
  }

  .kbzoom-level {
    min-width: 3.5rem;
    text-align: center;
    font-size: 0.8125rem;
    opacity: 0.7;
    user-select: none;
  }
</style>

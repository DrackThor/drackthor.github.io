---
// GoatCounter Analytics (privacy-friendly, cookieless).
// count.js records the initial pageview on load. astro:after-swap fires only
// on ClientRouter navigations (never the first load), so subsequent
// astro:transitions navigations are counted manually with no double-count.
// GoatCounter ignores localhost by default, so dev/preview don't pollute stats.
---

<script
  data-goatcounter="https://drackthor.goatcounter.com/count"
  async
  src="//gc.zgo.at/count.js"
></script>

<script>
  document.addEventListener("astro:after-swap", () => {
    // @ts-expect-error – injected by count.js
    window.goatcounter?.count?.({
      path: location.pathname + location.search + location.hash,
    });
  });
</script>
